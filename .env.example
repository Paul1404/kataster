# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://user:pass@localhost:5432/lfio

# Redis connection string (Railway: ${{Redis.REDIS_URL}})
REDIS_URL=redis://localhost:6379

# better-auth: 32+ byte random secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# Public base URL of the app (used by better-auth)
BETTER_AUTH_URL=http://localhost:3000

# Master key for encrypting connector credentials at rest (AES-256-GCM).
# Must be 32 bytes, base64-encoded, and STABLE across deploys.
# Generate: openssl rand -base64 32
LFIO_ENCRYPTION_KEY=replace-me-32-byte-base64-key

# Web server port (Railway injects PORT automatically)
PORT=3000

# Number of concurrent connector checks the worker runs
WORKER_CONCURRENCY=4

# Enable the MCP endpoint (POST /api/mcp). Must be exactly "true" to turn it on.
# When not "true", the endpoint returns 404 regardless of any token below.
MCP_ENABLED=false

# MCP endpoint bearer token. Optional env fallback for agent access to the
# inventory, margin and monitoring tools (in-app Settings tokens also work).
# Only used when MCP_ENABLED=true.
# Generate: openssl rand -base64 32
LFIO_MCP_TOKEN=

# Environment fallback tokens are read-only unless this is explicitly "write".
LFIO_MCP_ENV_ACCESS=read

# Mail-flow (map animation): how often the worker polls mailcow rspamd history for
# new mail events, in ms (min 3000). Lower = livelier packets, more API load.
MAIL_POLL_INTERVAL_MS=10000

# Number of concurrent mailcow mail-event polls the worker runs
MAIL_POLL_CONCURRENCY=1

# How long ingested mail events are kept (powers the scrub-back timeline)
MAIL_EVENTS_RETENTION_DAYS=7

# Raw probe history retention. Older checks are compacted into hourly uptime and
# latency aggregates by a daily worker job.
CHECK_RESULTS_RETENTION_DAYS=1

# Let the worker assign owners to unowned resources when the evidence is strong
# (owned parent or owned domain). Set to "false" to keep assignment manual.
BILLING_AUTO_ASSIGN=true

# Public hostname of the app. Requests for any other hostname (e.g. the old
# lfio.example.test) get a permanent redirect here. Leave empty to serve every host.
CANONICAL_HOST=

# Outbound notifications: how long a webhook POST may take before it is recorded
# as failed. Delivery targets themselves are configured in the app (Einstellungen
# > Benachrichtigungen) and stored encrypted.
NOTIFY_TIMEOUT_MS=8000

# Invoice sender block (your own company details). Printed on every invoice
# document; nothing is stored per invoice, so a correction here applies at once.
# When name and address are empty the document says so instead of printing a
# blank letterhead.
INVOICE_SENDER_NAME=
INVOICE_SENDER_ADDRESS=
INVOICE_SENDER_EMAIL=
INVOICE_SENDER_VAT_ID=
INVOICE_SENDER_IBAN=
